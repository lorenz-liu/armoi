# ---- Armoi backend environment ----
# Copy to .env and adjust. All keys are optional; defaults live in app/config.py.

ARMOI_APP_NAME=Armoi
ARMOI_ENV=dev
ARMOI_HOST=0.0.0.0
ARMOI_PORT=8000
ARMOI_DEBUG=true

# SQLAlchemy URL. Relative sqlite paths resolve against infra/.
# Production (Fly): postgres://... from `fly postgres attach`.
ARMOI_DATABASE_URL=sqlite:///./data/armoi.db

# Directory for uploaded item images (relative paths resolve against infra/).
# Ignored when ARMOI_MEDIA_BACKEND=s3.
ARMOI_MEDIA_DIR=./media
# local | s3
ARMOI_MEDIA_BACKEND=local

# Comma-separated list, or * for any origin (Expo dev clients use random ports).
ARMOI_CORS_ORIGINS=*

# Auth — change jwt_secret before any real deployment.
ARMOI_JWT_SECRET=dev-only-change-me-to-a-long-random-string
# Comma-separated Google OAuth client IDs (iOS / Android / Web).
ARMOI_GOOGLE_CLIENT_IDS=
# Apple bundle id (com.armoi.app) or Services ID.
ARMOI_APPLE_CLIENT_ID=com.armoi.app

# Tigris / S3 (required when ARMOI_MEDIA_BACKEND=s3)
# ARMOI_S3_ENDPOINT_URL=https://fly.storage.tigris.dev
# ARMOI_S3_REGION=auto
# ARMOI_S3_BUCKET=
# ARMOI_S3_ACCESS_KEY_ID=
# ARMOI_S3_SECRET_ACCESS_KEY=
# ARMOI_S3_PUBLIC_BASE_URL=
