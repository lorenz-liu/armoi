# ---- Armoi backend environment ----
# Copy to .env and adjust. All keys are optional; defaults live in app/config.py.

ARMOI_APP_NAME=Armoi
ARMOI_HOST=0.0.0.0
ARMOI_PORT=8000
ARMOI_DEBUG=true

# SQLAlchemy URL. Relative sqlite paths resolve against infra/.
ARMOI_DATABASE_URL=sqlite:///./data/armoi.db

# Directory for uploaded item images (relative paths resolve against infra/).
ARMOI_MEDIA_DIR=./media

# Comma-separated list, or * for any origin (Expo dev clients use random ports).
ARMOI_CORS_ORIGINS=*
