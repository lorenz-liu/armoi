# ---- Armoi mobile environment ----
# Copy to .env. Expo inlines EXPO_PUBLIC_* variables at build time.

# Leave this unset for local development: the app derives the backend address
# from whichever host is serving the bundle, so a simulator reaches
# 127.0.0.1 and a phone on the same Wi-Fi reaches your machine's LAN IP —
# no configuration either way.
#
# Set it only to point somewhere else, e.g. a deployed server or a tunnel:
# EXPO_PUBLIC_API_BASE_URL=https://armoi.example.com

# Port the backend listens on, if you changed it (`make dev API_PORT=9000`).
# EXPO_PUBLIC_API_PORT=8000
