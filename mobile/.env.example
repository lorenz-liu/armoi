# ---- Armoi mobile environment ----
# Copy to .env. Read at build time via expo-constants / EXPO_PUBLIC_ vars.

# Base URL of the FastAPI backend, without a trailing slash.
# Simulator: http://localhost:8000
# Physical device on the same Wi-Fi: http://<your-machine-lan-ip>:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
